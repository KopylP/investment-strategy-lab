<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A Debug build writes the API's OpenAPI document to backend/contracts/openapi.json; the frontend's types are generated from it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- The generator only watches this assembly; the endpoints live in the modules, so the document is written on every build. -->
  <Target Name="WriteOpenApiDocumentOnEveryBuild" BeforeTargets="GenerateOpenApiDocuments" Condition="'$(OpenApiGenerateDocuments)' == 'true'">
    <Delete Files="$(BaseIntermediateOutputPath)$(MSBuildProjectName).OpenApiFiles.cache" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../InvestmentLab.ServiceDefaults/InvestmentLab.ServiceDefaults.csproj" />
    <ProjectReference Include="../../BuildingBlocks/InvestmentLab.BuildingBlocks/InvestmentLab.BuildingBlocks.csproj" />
    <ProjectReference Include="../../Modules/Identity/InvestmentLab.Identity/InvestmentLab.Identity.csproj" />
    <ProjectReference Include="../../Modules/MarketData/InvestmentLab.MarketData/InvestmentLab.MarketData.csproj" />
    <ProjectReference Include="../../Modules/Strategies/InvestmentLab.Strategies/InvestmentLab.Strategies.csproj" />
    <ProjectReference Include="../../Modules/Portfolio/InvestmentLab.Portfolio/InvestmentLab.Portfolio.csproj" />
    <ProjectReference Include="../../Modules/Rebalancing/InvestmentLab.Rebalancing/InvestmentLab.Rebalancing.csproj" />
    <ProjectReference Include="../../Modules/Taxation/InvestmentLab.Taxation/InvestmentLab.Taxation.csproj" />
    <ProjectReference Include="../../Modules/Backtesting/InvestmentLab.Backtesting/InvestmentLab.Backtesting.csproj" />
    <ProjectReference Include="../../Modules/StrategyBuilder/InvestmentLab.StrategyBuilder/InvestmentLab.StrategyBuilder.csproj" />
    <ProjectReference Include="../../Modules/Performance/InvestmentLab.Performance/InvestmentLab.Performance.csproj" />
    <ProjectReference Include="../../Modules/Signals/InvestmentLab.Signals/InvestmentLab.Signals.csproj" />
    <ProjectReference Include="../../Modules/Notifications/InvestmentLab.Notifications/InvestmentLab.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InvestmentLab.IntegrationTests" />
  </ItemGroup>
</Project>
